---
import { Picture } from 'astro:assets'
import Search from '@astrojs/starlight/components/Search.astro'
import room from '../assets/room-band.webp'
---
<div class="docs-intro">
  <h1 id="_top">Renplay documentation</h1>
  <p>Install, add games, play and maintain your library. To see Renplay first, <a href="https://demo.renplay.org/">try the demo</a>.</p>
  <div class="home-search"><Search /></div>
</div>
<!-- The room, cropped to a band: the table, the lamp and the screens. The page's text is above it and does not need it. -->
<div class="docs-band" aria-hidden="true">
  <Picture src={room} alt="" width={1600} height={430} widths={[640, 1200, 1600]} sizes="(min-width: 1100px) 1056px, 100vw" formats={['avif']} fallbackFormat="webp" decoding="async" />
</div>
<script>
  // The lamp follows the pointer inside the band, as it does on the website. A touch screen and reduced motion keep it where it sits.
  const band = document.querySelector<HTMLElement>('.docs-band')
  if (band && matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    band.addEventListener('pointermove', (e) => {
      const r = band.getBoundingClientRect()
      band.style.setProperty('--x', `${e.clientX - r.left}px`)
      band.style.setProperty('--y', `${e.clientY - r.top}px`)
    })
    band.addEventListener('pointerleave', () => {
      band.style.removeProperty('--x')
      band.style.removeProperty('--y')
    })
  }
</script>
