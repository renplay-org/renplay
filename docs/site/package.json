{
  "name": "renplay-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "gen": "node scripts/gen-config.mjs",
    "check:config": "node scripts/gen-config.mjs --check",
