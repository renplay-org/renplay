    "build": "npm run gen && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/starlight": "0.42.8",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.4.5",
    "sharp": "0.35.5",
    "starlight-links-validator": "0.27.0"
  }
}
