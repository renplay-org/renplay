// The website at https://renplay.org, served by Cloudflare as static files.
// `sh build.sh` writes the public files into dist/ (and dist-adult/, see wrangler.adult.jsonc). .github/workflows/sites.yml
// deploys it with each release, every day and when the catalog changes, or by hand.
{
  "name": "renplay-website",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "renplay.org", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
