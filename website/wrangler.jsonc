// The website at https://renplay.org, served by Cloudflare as static files.
// `sh build.sh` copies the public files into dist/. .github/workflows/sites.yml deploys it with
// each release, or by hand.
{
  "name": "renplay-website",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "renplay.org", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
